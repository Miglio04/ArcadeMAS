mas exploration {
	
    agent player1:topologicalPlayer.asl {
		ag-class: vesna.VesnaAgent
		beliefs: address( localhost )
			port( 8083 )
			budget(20), tokens(0), token_price(2), friends([])
		goals:	play
		join: main

	}

	agent player2:directPlayer.asl {
		ag-class: vesna.VesnaAgent
		beliefs: address( localhost )
			port( 8084 )
			budget(20), tokens(0), token_price(2), friends([])
		goals:	play
		join: main

	}

    workspace main {
        artifact envManager: artifact.EnvManagerArtifact("envManager", 9500)
        artifact tokenMachine: artifact.TokenMachineArtifact("TokenMachine", 9503)
		artifact pacman: artifact.SinglePlayerGameArtifact("Pacman", 9501)
    }
}