mas arcade {
	agent player2:player.asl {
		ag-class: vesna.VesnaAgent
		beliefs: address( localhost )
			port( 3451 )
			budget(0), friends([])
		goals:	play
		join: ws

	}

	agent player1:player.asl {
		ag-class: vesna.VesnaAgent
		beliefs: address( localhost )
			port( 3450 )
			budget(0), friends([])
		goals:	play
		join: ws

	}

	workspace ws {
		artifact pacman3: artifact.SinglePlayerGameArtifact("Pacman3", 5203)
		artifact breakout1: artifact.SinglePlayerGameArtifact("Breakout1", 5401)
		artifact pacman2: artifact.SinglePlayerGameArtifact("Pacman2", 5202)
		artifact pacman1: artifact.SinglePlayerGameArtifact("Pacman1", 5200)
		artifact tetris1: artifact.SinglePlayerGameArtifact("Tetris1", 5301)
		artifact breakout: artifact.SinglePlayerGameArtifact("Breakout", 5400)
		artifact tokenMachine: artifact.TokenMachineArtifact("TokenMachine", 5100)
		artifact tetris: artifact.SinglePlayerGameArtifact("Tetris", 5300)
		artifact pacman: artifact.SinglePlayerGameArtifact("Pacman", 5200)
		artifact envManager: artifact.EnvManagerArtifact("envManager", 34)
	}
}
