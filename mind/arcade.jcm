mas arcade {
	agent npc:player.asl {
		ag-class: vesna.VesnaAgent
		beliefs: address( localhost )
			port( 3450 )
			budget(0), friends([])
		goals:	play
		join: ws

	}

	workspace ws {
		artifact breakout2: artifact.SinglePlayerGameArtifact("Breakout2", 5204)
		artifact pacman: artifact.SinglePlayerGameArtifact("Pacman", 5201)
		artifact tetris: artifact.SinglePlayerGameArtifact("Tetris", 5203)
		artifact breakout: artifact.SinglePlayerGameArtifact("Breakout", 5202)
		artifact envManager: artifact.EnvManagerArtifact("envManager", 34)
	}
}
